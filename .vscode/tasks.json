{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend",
      "type": "shell",
      "command": ".\\gradlew.bat bootRun",
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Vision",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe main.py",
      "options": {
        "cwd": "${workspaceFolder}\\vision"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run All",
      "dependsOn": [
        "Run Backend",
        "Run Vision"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}